# =============================================================================
# YAROX Environment Configuration Template (.env.example)
# Copy this file to .env and configure appropriate values for your environment.
# =============================================================================

# Project Metadata & Environment Mode (development, staging, production, test)
PROJECT_NAME="YAROX"
VERSION="0.2.0"
ENVIRONMENT="development"

# Database & Broker (Internal Docker Service Names)
POSTGRES_USER=yarox
POSTGRES_PASSWORD=yaroxpassword
POSTGRES_DB=yarox
DATABASE_URL=postgresql+asyncpg://yarox:yaroxpassword@postgres:5432/yarox
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1

# LLM provider. Local inference is the default: security telemetry must not leave the
# deployment. "anthropic" additionally requires LLM_ALLOW_EXTERNAL_PROVIDERS=true.
# ollama | vllm | anthropic | gemini
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1
# empty: use OLLAMA_BASE_URL / VLLM_BASE_URL
LLM_BASE_URL=
VLLM_BASE_URL=http://vllm:8000
LLM_ALLOW_EXTERNAL_PROVIDERS=false
ANTHROPIC_API_KEY=
LLM_TIMEOUT_SECONDS=180
LLM_MAX_ATTEMPTS=3
# a local model server handles few requests at a time
LLM_MAX_CONCURRENCY=2
LLM_CONTEXT_TOKENS=8192

# JWT Authentication & RBAC (Human User Access)
# Generate a secure key in production using: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Live Telemetry Ingestion (Machine-to-Machine API Key)
# Generate a secure key in production using: openssl rand -hex 32
INGESTION_API_KEY=change-this-to-a-secure-random-ingest-key-in-production-2026
RATE_LIMIT_INGEST_PER_MINUTE=120

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3002

# Default Seed Credentials (Override for production deployments)
INITIAL_ADMIN_EMAIL=admin@yarox.local
INITIAL_ADMIN_PASSWORD=YaroxAdmin2026!
INITIAL_ANALYST_EMAIL=analyst@yarox.local
INITIAL_ANALYST_PASSWORD=YaroxAnalyst2026!
INITIAL_VIEWER_EMAIL=viewer@yarox.local
INITIAL_VIEWER_PASSWORD=YaroxViewer2026!

# Gemini (cloud phase)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
